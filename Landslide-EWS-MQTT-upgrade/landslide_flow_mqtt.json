    "id": "log_format",
    "type": "function",
    "z": "tab_landslide",
    "name": "Format Log",
    "func": "var ts = new Date().toLocaleTimeString('id-ID');\nmsg.payload = ts + ' ' + (msg.payload.log || JSON.stringify(msg.payload));\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 400,

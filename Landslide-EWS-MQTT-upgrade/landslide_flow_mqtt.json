    "id": "influx_format_node",
    "type": "function",
    "z": "tab_landslide",
    "name": "Format for InfluxDB",
    "func": "var d = msg.payload;\nif (!d || typeof d.tilt === 'undefined') return null;\n\nmsg.payload = {\n    tilt: parseFloat(d.tilt) || 0,\n    gravity: parseFloat(d.gravity) || 0,\n    rotation: parseFloat(d.rotation) || 0,\n    piezo: parseFloat(d.piezo) || 0,\n    hazard: parseFloat(d.hazard) || 0\n};\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 580,

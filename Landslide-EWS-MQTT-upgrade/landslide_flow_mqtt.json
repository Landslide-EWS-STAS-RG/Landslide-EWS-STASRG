  {
    "id": "route_data",
    "type": "function",
    "z": "tab_landslide",
    "name": "Route to Dashboard",
    "func": "var d = msg.payload;\nif (!d || typeof d.tilt === 'undefined') return null;\n\nvar state = d.state || 'UNKNOWN';\nvar map = {\n    'NORMAL':   { color: '#00C853', label: 'AMAN' },\n    'WATCH':    { color: '#F9A825', label: 'WASPADA' },\n    'WARNING':  { color: '#EF6C00', label: 'PERINGATAN' },\n    'DANGER':   { color: '#C62828', label: 'BAHAYA' },\n    'CRITICAL': { color: '#6A1B9A', label: 'KRITIS' }\n};\nvar c = map[state] || { color: '#607D8B', label: state };\nvar banner = '<div style=\"text-align:center;padding:8px;border-radius:8px;background:' + c.color + ';color:#fff;font-weight:bold;font-size:1.8em;\">' + c.label + '</div>';\n\nvar ts = new Date().toLocaleTimeString('id-ID');\nvar logStr = ts + ' | T:' + d.tilt.toFixed(2) + ' G:' + d.gravity.toFixed(3) + ' R:' + d.rotation.toFixed(1) + ' P:' + d.piezo.toFixed(0) + ' H:' + d.hazard.toFixed(0) + ' ' + state;\n\nnode.status({fill:'green', shape:'dot', text: state + ' H:' + d.hazard.toFixed(0)});\n\nreturn [\n    {payload: d.tilt},\n    {payload: d.hazard},\n    {payload: d.rotation},\n    {payload: d.gravity},\n    {payload: d.piezo},\n    {payload: state},\n    {payload: banner},\n    {payload: d.tilt},\n    {payload: d.piezo},\n    {payload: d.rotation},\n    {payload: d.gravity},\n    {payload: d.hazard},\n    {payload: logStr}\n];",
    "outputs": 13,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 100,
    "wires": [
      [
        "gauge_tilt"
      ],
      [
        "gauge_hazard"
      ],
      [
        "gauge_rotation"
      ],
      [
        "gauge_gravity"
      ],
      [
        "gauge_piezo"
      ],
      [
        "text_state"
      ],
      [
        "text_banner"
      ],

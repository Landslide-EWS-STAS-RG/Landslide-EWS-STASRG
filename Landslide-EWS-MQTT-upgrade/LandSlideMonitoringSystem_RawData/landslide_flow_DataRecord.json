  {
    "id": "fn_event",
    "type": "function",
    "z": "flow_ews_dr",
    "name": "Decode new events",
    "func": "// Turn newEvents bitmask into a human-readable toast notification.\n// Bit order matches EventFlag in LandslideMonitoringSystem_MQTT_Raw.ino.\nconst EVENT_NAMES = [\n    \"Sudden impact\",                 // bit 0\n    \"Continuous vibration\",          // bit 1\n    \"Rapid tilt\",                    // bit 2\n    \"Progressive tilt\",              // bit 3\n    \"Sensor disturbance\",            // bit 4\n    \"Earthquake-like vibration\",     // bit 5\n    \"Slow landslide\",                // bit 6\n    \"Sudden landslide\",              // bit 7\n    \"Continuous creep\",              // bit 8\n    \"FIFO overflow\",                 // bit 9\n    \"Repeated piezo vibration\",      // bit 10\n    \"Continuous piezo vibration\",    // bit 11\n    \"Piezo impact\",                  // bit 12\n    \"Rockfall-like impact\",          // bit 13\n    \"Environmental vibration\",       // bit 14\n    \"Mechanical vibration\"           // bit 15\n];\n\nconst d = msg.payload;\nif (!d || typeof d.newEvents !== \"number\" || d.newEvents === 0) { return null; }\n\nconst active = [];\nfor (let i = 0; i < 16; i++) {\n    if (d.newEvents & (1 << i)) { active.push(EVENT_NAMES[i]); }\n}\n\nmsg.topic = \"EWS event (\" + d.state + \")\";\nmsg.payload = active.join(\", \");\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 600,
    "wires": [

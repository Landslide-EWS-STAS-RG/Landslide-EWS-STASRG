  {
    "id": "fn_influx",
    "type": "function",
    "z": "flow_ews_dr",
    "name": "Format for InfluxDB (DataRecord)",
    "func": "// Build the InfluxDB point for the single DataRecord channel.\n// Output: msg.payload = [fields, tags] (node-red-contrib-influxdb format).\nconst d = msg.payload;\nif (!d || typeof d !== \"object\") { return null; }\n\nconst numericKeys = [\n    \"accelX\", \"accelY\", \"accelZ\",\n    \"gyroX\", \"gyroY\", \"gyroZ\",\n    \"accelMag\",\n    \"roll\", \"pitch\", \"tilt\", \"tiltVelocity\",\n    \"gravityDiff\", \"gravitySlope\", \"shock\", \"rotation\",\n    \"piezoRaw\", \"piezoVoltage\", \"piezoAmp\", \"piezoPeak\",\n    \"piezoPeakCount\", \"piezoPps\",\n    \"vibIndex\", \"confidence\", \"hazard\",\n    \"events\", \"newEvents\", \"rssi\", \"ts\"\n];\n\nconst fields = {};\nfor (const key of numericKeys) {\n    if (typeof d[key] === \"number\" && isFinite(d[key])) {\n        fields[key] = d[key];\n    }\n}\n\nconst tags = {\n    device: d.device || \"unknown\",\n    state: d.state || \"UNKNOWN\",\n    vibState: d.vibState || \"UNKNOWN\"\n};\n\nmsg.payload = [fields, tags];\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 160,
    "wires": [
      [
        "influx_out_dr"
      ]
    ]
  },
  {
    "id": "influx_out_dr",
    "type": "influxdb out",
    "z": "flow_ews_dr",
    "influxdb": "influxdb_local",
    "name": "InfluxDB: DataRecord",
    "measurement": "DataRecord",
    "precision": "",
    "retentionPolicy": "",
    "database": "database",
    "precisionV18FluxV20": "ms",
    "retentionPolicyV18Flux": "",
    "org": "iot_project",
    "bucket": "landslide_data",
    "x": 800,
    "y": 160,
    "wires": []
  },
  {
    "id": "fn_dash",
    "type": "function",
    "z": "flow_ews_dr",
    "name": "Route to Dashboard",
    "func": "// Fan the DataRecord out to the dashboard widgets.\nconst d = msg.payload;\nif (!d || typeof d !== \"object\") { return null; }\n\nconst mk = (value, topic) => ({ payload: value, topic: topic });\n\nreturn [\n    [mk(d.tilt, \"tilt\")],                                        // 1: Tilt gauge\n    [mk(d.hazard, \"hazard\")],                                    // 2: Hazard gauge\n    [mk(d.vibIndex, \"vibIndex\")],                                // 3: Vibration index gauge\n    [mk(d.state + \" | vib: \" + d.vibState, \"state\")],            // 4: State text\n    [mk(d.accelX, \"accelX\"), mk(d.accelY, \"accelY\"), mk(d.accelZ, \"accelZ\")], // 5: Raw accel chart\n    [mk(d.gyroX, \"gyroX\"), mk(d.gyroY, \"gyroY\"), mk(d.gyroZ, \"gyroZ\")],       // 6: Raw gyro chart\n    [mk(d.piezoRaw, \"piezoRaw\")],                                // 7: Raw piezo chart\n    [mk(\"RSSI \" + d.rssi + \" dBm | peaks/s \" + d.piezoPps + \" | shock \" + (d.shock !== undefined ? d.shock.toFixed(3) : \"?\") + \" g\", \"info\")] // 8: Info text\n];\n",
    "outputs": 8,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 320,
    "wires": [
      [
        "gauge_tilt"
      ],
      [
        "gauge_hazard"
      ],
      [
        "gauge_vib"
      ],
      [
        "text_state"
      ],
      [
        "chart_accel"
      ],
      [
        "chart_gyro"
      ],
      [
        "chart_piezo"
      ],
      [
        "text_info"
      ]
    ]
  },

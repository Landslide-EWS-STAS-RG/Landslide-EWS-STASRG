{
  "version": 1,
  "author": "Landslide EWS",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp32",
      "top": 0,
      "left": 0,
      "attrs": { "fullBoot": "1" },
      "label": "DFRobot FireBeetle ESP32"
    },
    {
      "type": "wokwi-mpu6050",
      "id": "imu1",
      "top": -80,
      "left": 300,
      "attrs": { "i2cAddress": "0x6B" },
      "label": "GY-LSM6DS3 (simulated)"
    },
    {
      "type": "wokwi-slide-potentiometer",
      "id": "vibration1",
      "top": 80,
      "left": 300,
      "attrs": { "value": "0" },
      "label": "DFRobot Piezo Vibration Sensor"
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay1",
      "top": 160,
      "left": 300,
      "attrs": {},
      "label": "Relay 1 Channel"
    },
    {
      "type": "wokwi-buzzer",
      "id": "siren1",
      "top": 240,
      "left": 300,
      "attrs": { "volume": "1.0" },
      "label": "Mini Siren Strobo 12V DC"
    },
    {
      "type": "wokwi-led",
      "id": "ledRed",
      "top": 320,
      "left": 300,
      "attrs": { "color": "red" },
      "label": "LED Merah - Bahaya"
    },
    {
      "type": "wokwi-led",
      "id": "ledYellow",
      "top": 320,
      "left": 350,
      "attrs": { "color": "yellow" },
      "label": "LED Kuning - Waspada"
    },
    {
      "type": "wokwi-led",
      "id": "ledGreen",
      "top": 320,
      "left": 400,
      "attrs": { "color": "green" },
      "label": "LED Hijau - Aman"
    },
    {
      "type": "wokwi-led",
      "id": "ledPower",
      "top": 320,
      "left": 450,
      "attrs": { "color": "blue" },
      "label": "LED Biru - Power ON"
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd1",
      "top": 400,
      "left": 200,
      "attrs": { "pins": "i2c", "address": "0x27" },
      "label": "LCD 16x2 I2C"
    }
  ],
  "connections": [
    ["esp32:TX0", "$serialMonitor:RX", "", []],
    ["esp32:RX0", "$serialMonitor:TX", "", []],

    ["esp32:3V3",  "imu1:VCC",  "red",    ["h0"]],
    ["esp32:GND.1","imu1:GND",  "black",  ["h0"]],
    ["esp32:21",   "imu1:SDA",  "green",  ["h0"]],
    ["esp32:22",   "imu1:SCL",  "yellow", ["h0"]],

    ["esp32:3V3",  "vibration1:VCC", "red",   ["h0"]],
    ["esp32:GND.1","vibration1:GND", "black", ["h0"]],
    ["esp32:34",   "vibration1:SIG", "blue",  ["h0"]],

    ["esp32:5V",   "relay1:VCC", "red",   ["h0"]],
    ["esp32:GND.1","relay1:GND", "black", ["h0"]],
    ["esp32:26",   "relay1:IN",  "orange",["h0"]],

    ["relay1:COM", "siren1:1",  "red",   ["h0"]],
    ["esp32:5V",   "siren1:2",  "black", ["h0"]],

    ["esp32:27",   "ledRed:A",   "red",    ["h0"]],
    ["esp32:GND.2","ledRed:K",   "black",  ["h0"]],
    ["esp32:14",   "ledYellow:A","yellow", ["h0"]],
    ["esp32:GND.2","ledYellow:K","black",  ["h0"]],
    ["esp32:12",   "ledGreen:A", "green",  ["h0"]],
    ["esp32:GND.2","ledGreen:K", "black",  ["h0"]],
    ["esp32:3V3",  "ledPower:A", "blue",   ["h0"]],
    ["esp32:GND.2","ledPower:K", "black",  ["h0"]],

    ["esp32:3V3",  "lcd1:VCC", "red",    ["h0"]],
    ["esp32:GND.2","lcd1:GND", "black",  ["h0"]],
    ["esp32:21",   "lcd1:SDA", "green",  ["h0"]],
    ["esp32:22",   "lcd1:SCL", "yellow", ["h0"]]
  ]
}
